# Copy to .env next to agent.py (chmod 600) or supply as environment variables (Coolify).
# Never commit real values; OS environment variables override .env.
HIKVISION_HOST=192.168.88.187
HIKVISION_SCHEME=http
HIKVISION_USERNAME=agent-reader
HIKVISION_PASSWORD=replace-with-device-password
HIKVISION_VERIFY_TLS=true
EPCA_API_URL=https://one.epcafrica.com/api/internal/attendance/events/
EPCA_DEVICE_CODE=EPCA-HQ-01
EPCA_DEVICE_TOKEN=replace-with-one-time-token
# DS-K1T8003MF (V1.3.37): start with 15-30 seconds. Go lower only after a multi-day soak test shows
# no HTTP 401 / lockout warnings in the journal. The agent never changes this value; below 15 it warns.
POLL_INTERVAL_SECONDS=30
# Persistent queue/cursor directory. Ubuntu + systemd: /var/lib/epca-attendance-agent (the unit's
# StateDirectory creates it for the epca user). Docker/Coolify: /data (set by the Dockerfile).
# Native Windows: a full path, e.g. C:\EPCAttendance-agent\data.
AGENT_DATA_DIR=/var/lib/epca-attendance-agent
# Optional explicit override. Defaults to $AGENT_DATA_DIR/attendance_agent.db.
# AGENT_DATABASE_PATH=/var/lib/epca-attendance-agent/attendance_agent.db
# First start only queues recent events; the terminal's full history is skipped by default.
INITIAL_SYNC_LOOKBACK_HOURS=24
INITIAL_SYNC_MAX_EVENTS=1000
INITIAL_SYNC_FULL_HISTORY=false
# DS-K1T8003MF V1.3.37 accepts at most 10 results per AcsEvent page.
EVENT_PAGE_SIZE=10
HIKVISION_EVENT_MAJOR=5
HIKVISION_EVENT_MINOR=38
# Failure backoff (independent of POLL_INTERVAL_SECONDS): 5s, 10s, 20s ... capped at the max.
RETRY_INITIAL_SECONDS=5
RETRY_MAX_SECONDS=300
# Hikvision lockout protection. On a 401 with lockStatus=lock no request is sent for the device's
# unlockTime (or LOCK_DEFAULT when it is missing) plus the margin. A 401 that survives one fresh-session
# retry pauses the device for AUTH_COOLDOWN seconds, doubling on repeats up to one hour.
HIKVISION_LOCK_DEFAULT_SECONDS=1800
HIKVISION_LOCK_MARGIN_SECONDS=30
HIKVISION_AUTH_COOLDOWN_SECONDS=300
# INFO logs startup, discoveries, deliveries, failures, recoveries and an hourly status line.
# DEBUG adds every AcsEvent request (never credentials).
LOG_LEVEL=INFO
